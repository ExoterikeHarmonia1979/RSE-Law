{
  "name": "matters-eml-indexer",
  "dataSourceName": "matters-blob-ds",
  "targetIndexName": "matters-eml-index",
  "skillsetName": "matters-eml-skillset",
  "schedule": {
    "interval": "PT1H"
  },
  "parameters": {
    "batchSize": null,
    "maxFailedItems": 1000,
    "maxFailedItemsPerBatch": 200,
    "configuration": {
      "indexedFileNameExtensions": ".eml,.msg",
      "dataToExtract": "contentAndMetadata",
      "parsingMode": "default",
      "failOnUnsupportedContentType": false,
      "failOnUnprocessableDocument": false,
      "allowSkillsetToReadFileData": true,
      "indexStorageMetadataOnlyForOversizedDocuments": true
    }
  },
  "fieldMappings": [
    {
      "sourceFieldName": "metadata_storage_path",
      "targetFieldName": "metadata_storage_path",
      "mappingFunction": { "name": "base64Encode" }
    }
  ],
  "outputFieldMappings": [
    {
      "sourceFieldName": "/document/attachmentNames",
      "targetFieldName": "attachment_names"
    },
    {
      "sourceFieldName": "/document/sentDate",
      "targetFieldName": "sent_date"
    },
    {
      "sourceFieldName": "/document/content_vector",
      "targetFieldName": "content_vector"
    }
  ]
}
