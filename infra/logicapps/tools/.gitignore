# Run artefacts, not source. These are rebuilt on demand and some are large:
# archive-blobs.txt is a full listing of the container (~350k lines, tens of MB) and
# archive-tails.txt is the index derived from it. Both are caches keyed by mtime.
archive-blobs.txt
archive-tails.txt
allblobs*.txt

# One CSV per reconciler run, plus the scheduled task's logs.
missed-reconcile-*.csv
reconcile-logs/

# One CSV per orphan scan.
index-orphans-*.csv
index-unbacked-*.csv

# Full message text of purged index rows - correspondence, never committed.
purged-documents-*.json

# Message-ID index: ~255k rows derived from blob headers, rebuildable, and it maps
# message identifiers to matter paths - not something to commit.
messageid-index.tsv
older-mail-*.csv

# Dry-run artefacts for the duplicate cleanup. Both list real blob paths, which carry
# matter numbers and message subjects - operational scratch, never source.
dedup-manifest*.tsv
dedup-resolved.tsv

# Execution artefacts for the same cleanup. All list real blob paths, so the same rule
# applies. dedup-deleted.log is a run's resume checkpoint and is meaningless outside it.
current-blobs.tsv
current-blobs.tsv.partial
dedup-validated.tsv
dedup-skipped.tsv
dedup-deletes.txt
dedup-deleted.log
dedup-unreadable-keeps.tsv
dedup-staleness-findings.txt
