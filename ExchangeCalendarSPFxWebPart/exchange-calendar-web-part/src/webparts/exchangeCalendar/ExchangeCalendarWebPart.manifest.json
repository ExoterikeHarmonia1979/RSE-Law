    "group": { "default": "Advanced" },
    "title": { "default": "ExchangeCalendar" },
    "description": { "default": "Displays the Calendar@RSE-Law.com Exchange calendar with Day, Week, and Month views" },
    "officeFabricIconFontName": "Page",
